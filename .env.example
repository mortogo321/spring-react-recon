# Copy to .env to override any of these. docker compose up works with none of them set.

# --- ports on the host ---------------------------------------------------
API_PORT=8080
WEB_PORT=5173
MYSQL_PORT=3306
ORACLE_PORT=1521

# --- application database -----------------------------------------------
MYSQL_DATABASE=recon
MYSQL_USER=recon
MYSQL_PASSWORD=recon
MYSQL_ROOT_PASSWORD=root

# --- legacy oracle ------------------------------------------------------
# SYS/SYSTEM password for the container. Only the init script uses it.
ORACLE_SYS_PASSWORD=oracle
ORACLE_SERVICE=FREEPDB1
# The read-only account the API connects as; the schema owner has no login at all.
ORACLE_APP_USER=recon_ro
ORACLE_APP_PASSWORD=recon_ro

# --- demo console users -------------------------------------------------
# Replaced wholesale by an identity provider in any real deployment; see SecurityConfig.
RECON_OPERATOR_PASSWORD=operator
RECON_APPROVER_PASSWORD=approver
RECON_ADMIN_PASSWORD=admin
